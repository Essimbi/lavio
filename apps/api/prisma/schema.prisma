// Modèle de données Lavio (docs/03-modele-de-donnees.md).
// Phase 0 : tables de la plateforme. Les tables du pressing arrivent à partir de la phase 1.
// Conventions : modèles en PascalCase, tables et colonnes en snake_case, montants en BigInt (FCFA).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Énumérations (identiques à packages/shared/src/enums.ts, vérifié par test)
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum LicenseStatus {
  TRIAL
  ACTIVE
  GRACE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum LicenseEventType {
  CREATED
  RENEWED
  PLAN_CHANGED
  SUSPENDED
  REACTIVATED
  REVOKED
  EXPIRED
  GRACE_STARTED
}

enum PlatformRole {
  SUPER_ADMIN
  PARTNER_VIEWER
}

enum TenantRole {
  OWNER
  CASHIER
  OPERATOR
  STOCK_KEEPER
  ACCOUNTANT
  QUALITY
  DRIVER
}

enum SubscriptionPaymentMethod {
  CASH
  ORANGE_MONEY
  MTN_MOMO
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum SubscriptionPaymentStatus {
  RECORDED
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  REJECTED
}

// ---------------------------------------------------------------------------
// Plateforme (sans tenant_id)
// ---------------------------------------------------------------------------

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  slug         String       @unique
  status       TenantStatus @default(ACTIVE)
  phone        String?
  address      String?
  city         String?
  niu          String?
  rccm         String?
  vatEnabled   Boolean      @default(false) @map("vat_enabled")
  /// Taux de TVA en pourcentage (ex. 19.25), jamais en dur dans le code.
  vatRate      Decimal?     @map("vat_rate") @db.Decimal(5, 2)
  ticketPrefix String?      @map("ticket_prefix")
  ticketFooter String?      @map("ticket_footer")
  logoUrl      String?      @map("logo_url")
  /// Jours de tournée, 0 = dimanche.
  tourDays     Int[]        @default([2, 5]) @map("tour_days")
  /// Seuils et paramètres (voir TenantSettings dans @lavio/shared).
  settings     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                User[]
  licenses             License[]
  subscriptionPayments SubscriptionPayment[]
  auditLogs            AuditLog[]

  @@map("tenants")
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  /// null = utilisateur plateforme.
  tenantId           String?       @map("tenant_id") @db.Uuid
  email              String?       @unique
  phone              String?       @unique
  passwordHash       String?       @map("password_hash")
  fullName           String        @map("full_name")
  tenantRoles        TenantRole[]  @default([]) @map("tenant_roles")
  platformRole       PlatformRole? @map("platform_role")
  isActive           Boolean       @default(true) @map("is_active")
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  lastLoginAt        DateTime?     @map("last_login_at") @db.Timestamptz(3)
  failedLogins       Int           @default(0) @map("failed_logins")
  lockedUntil        DateTime?     @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  invitations   Invitation[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Famille de rotation : une réutilisation révoque toute la famille.
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Invitation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("invitations")
}

model Plan {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  name              String
  /// null = prix non défini (« Tarif sur demande » sur la landing).
  priceMonthlyXaf   BigInt?  @map("price_monthly_xaf")
  priceYearlyXaf    BigInt?  @map("price_yearly_xaf")
  includedUsers     Int      @default(2) @map("included_users")
  extraUserPriceXaf BigInt?  @map("extra_user_price_xaf")
  trialDays         Int      @default(14) @map("trial_days")
  /// Drapeaux de fonctionnalités (stock, accounting, tours, push…).
  features          Json     @default("{}")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  licenses License[]

  @@map("plans")
}

model License {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  planId    String        @map("plan_id") @db.Uuid
  /// Format LAVIO-XXXX-XXXX-XXXX (Crockford base32).
  key       String        @unique
  status    LicenseStatus
  startsAt  DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime      @map("ends_at") @db.Timestamptz(3)
  graceDays Int           @default(7) @map("grace_days")
  /// Surcharge du nombre d'utilisateurs du plan.
  maxUsers  Int?          @map("max_users")
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan     Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  events   LicenseEvent[]
  payments SubscriptionPayment[]

  // Index partiel unique « une seule licence courante par pressing » : voir la migration SQL.
  @@index([tenantId])
  @@index([status, endsAt])
  @@map("licenses")
}

model LicenseEvent {
  id        String           @id @default(uuid()) @db.Uuid
  licenseId String           @map("license_id") @db.Uuid
  type      LicenseEventType
  payload   Json             @default("{}")
  /// null = action automatique (cron).
  actorId   String?          @map("actor_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  license License @relation(fields: [licenseId], references: [id], onDelete: Restrict)

  @@index([licenseId, createdAt])
  @@map("license_events")
}

model SubscriptionPayment {
  id            String                    @id @default(uuid()) @db.Uuid
  tenantId      String                    @map("tenant_id") @db.Uuid
  licenseId     String                    @map("license_id") @db.Uuid
  amountXaf     BigInt                    @map("amount_xaf")
  method        SubscriptionPaymentMethod
  reference     String?
  receivedAt    DateTime                  @map("received_at") @db.Timestamptz(3)
  periodStart   DateTime                  @map("period_start") @db.Timestamptz(3)
  periodEnd     DateTime                  @map("period_end") @db.Timestamptz(3)
  deductionsXaf BigInt                    @default(0) @map("deductions_xaf")
  deductionNote String?                   @map("deduction_note")
  status        SubscriptionPaymentStatus @default(RECORDED)
  recordedBy    String                    @map("recorded_by") @db.Uuid
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  license License @relation(fields: [licenseId], references: [id], onDelete: Restrict)

  @@index([tenantId, receivedAt])
  @@index([receivedAt])
  @@map("subscription_payments")
}

model Lead {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  pressingName String     @map("pressing_name")
  phone        String
  city         String?
  message      String?
  status       LeadStatus @default(NEW)
  source       String     @default("landing")
  /// Empreinte de l'adresse IP (jamais l'IP en clair).
  ipHash       String?    @map("ip_hash")
  contactedAt  DateTime?  @map("contacted_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("leads")
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Transverse
// ---------------------------------------------------------------------------

/// Journal d'audit en ajout seul (jamais modifié ni supprimé : trigger SQL dans la migration).
model AuditLog {
  id       String   @id @default(uuid()) @db.Uuid
  /// null = action plateforme.
  tenantId String?  @map("tenant_id") @db.Uuid
  userId   String?  @map("user_id") @db.Uuid
  action   String
  entity   String
  entityId String?  @map("entity_id")
  before   Json?
  after    Json?
  ip       String?
  at       DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, at])
  @@index([entity, entityId])
  @@map("audit_logs")
}
