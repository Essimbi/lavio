# Copier en .env (jamais commité). Valeurs locales fictives uniquement.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=true

# PostgreSQL local (docker-compose.yml). En production : chaîne Neon poolée.
DATABASE_URL=postgresql://lavio:lavio_local_only@localhost:54329/lavio
# Connexion directe (migrations). En production : chaîne Neon non poolée.
DIRECT_URL=postgresql://lavio:lavio_local_only@localhost:54329/lavio

APP_URL=http://localhost:4200

# Seed : premier SUPER_ADMIN (mot de passe à changer à la première connexion, 10 caractères min.)
SUPERADMIN_EMAIL=admin@lavio.local
SUPERADMIN_INITIAL_PASSWORD=
# Numéro WhatsApp du service client, chiffres seuls, copié dans platform_settings au seed.
WHATSAPP_DEFAULT_NUMBER=
# Prix du plan STANDARD en FCFA (vides = « Tarif sur demande »).
SEED_PLAN_PRICE_MONTHLY_XAF=
SEED_PLAN_PRICE_YEARLY_XAF=
# Pressing de démonstration (jamais en production).
SEED_DEMO=true

# Phases suivantes (laisser vides en phase 0)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
SENTRY_DSN=
