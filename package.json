{
  "name": "lavio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lavio/shared build && pnpm --parallel --filter api --filter web --filter @lavio/shared run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -r run test:e2e",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "sh scripts/compose.sh up -d --wait",
    "db:down": "sh scripts/compose.sh down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": ">=9.30.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": ">=10.1.0",
    "globals": ">=16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,html}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yml,yaml}": "prettier --write"
  }
}
